# VASU Assistant - Environment Configuration
# Copy this file to .env and fill in your API keys

# AI PROVIDERS
# Primary: Google Gemini (FREE tier available)
GEMINI_API_KEY=""

# Secondary: OpenRouter (FREE models available)
OPENROUTER_API_KEY=""

# Tertiary: Groq (FREE tier available)
GROQ_API_KEY=""

# DeepSeek (Promotional credits available)
DEEPSEEK_API_KEY=""

# xAI / Grok (Paid)
XAI_API_KEY=""

# Custom OpenAI-compatible provider
CUSTOM_OPENAI_BASE_URL=""
CUSTOM_OPENAI_API_KEY=""
CUSTOM_OPENAI_MODEL=""

# WEB SEARCH PROVIDERS
# Tavily Search (FREE tier: 1000 requests/month)
TAVILY_API_KEY=""

# Brave Search ($5 free monthly credits)
BRAVE_SEARCH_API_KEY=""

# APP CONFIGURATION
APP_URL="MY_APP_URL"
